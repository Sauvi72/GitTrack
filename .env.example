# Environment Configuration for OpenTrack

# Application
APP_ENV=development
DEBUG=True
SECRET_KEY=opentrack-development-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./opentrack.db

# GitHub API Integration
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_MAX_RETRIES=3
GITHUB_RETRY_BACKOFF=1.5

# Teacher Admin Initial Credentials (seeded on first startup if no teachers exist)
INITIAL_TEACHER_EMAIL=teacher@opentrack.edu
INITIAL_TEACHER_PASSWORD=OpenTrack2026!
INITIAL_TEACHER_NAME="Prof. Davis"

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
